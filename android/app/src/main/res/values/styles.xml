<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark-only: the launch window must be the night-sky black in
         BOTH system modes, otherwise phones in light mode flash white before
         Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it initializes / runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/juntra_night</item>
    </style>
</resources>
