<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Nothing of the app is backed up or moved to a
     new phone: the sign-in token lives in flutter_secure_storage, whose key is
     in the Android Keystore and does NOT travel with a backup — a restored
     copy fails to decrypt (InvalidKeyException) and the app would start in a
     broken signed-in state. Users simply sign in again on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
