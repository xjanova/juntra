<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for AI chat, fortune API and the web card art. That is the
         only permission the app itself asks for: haptics go through Flutter's
         HapticFeedback (no VIBRATE needed) and nothing checks connectivity. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- No storage/media permissions at all. Picking a slip photo goes
         through image_picker, which uses the system Photo Picker (Android 13+)
         or GET_CONTENT and needs no permission; taking a photo goes through
         the camera app (ACTION_IMAGE_CAPTURE), which also needs none as long
         as CAMERA is NOT declared here — declaring it would make the camera
         intent require a runtime grant.

         Google Play only allows READ_MEDIA_IMAGES/VIDEO to apps whose core
         feature is broad media access, so the ones a plugin merges in
         (open_filex declares all four) are stripped here for every build. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>

    <!-- REQUEST_INSTALL_PACKAGES (the self-updater) lives only in
         src/direct/AndroidManifest.xml — a Google Play build must never ask
         for it, because Play apps may only be updated by Play. -->

    <application
        android:label="จันทราพยากรณ์"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="false">

        <!-- Android 16 (target 36) ignores the portrait lock on screens >= 600dp
             (tablets, foldables). Every screen here is portrait-tuned, so opt out
             while the opt-out exists; it goes away with target 37 (Aug 2027),
             by which time layouts must adapt. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- For url_launcher (privacy policy, sharing referral link out to LINE/Messenger) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
